<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Android 12+ (API 31+) runtime permissions. We never derive physical -->
    <!-- location from scan results, so BLUETOOTH_SCAN is neverForLocation. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Pre-12 legacy path: install-time Bluetooth perms + runtime location, -->
    <!-- which the OS required in order to return BLE scan results. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Uncapped (no maxSdkVersion): doubles as the pre-12 BLE-scan permission
         above AND the real GPS fix for the SOS location field on every SDK
         version. A denied or no-fix state is not an error: gps_valid=0 and a
         manual pin-drop path handle it, never a blocking error. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Stage 5: foreground service so advertise/scan survive screen-off + doze. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Haptic feedback on state changes, for a user who may not be able to see the screen. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wi-Fi Direct: same-room, single-hop bulk transfer for personal card / -->
    <!-- voicenote / image attachments (see CLAUDE.md); never used for the -->
    <!-- core mesh, which stays BLE-only. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".mesh.MeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
